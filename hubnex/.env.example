# Uso fuori da Home Assistant (Docker/Python). Da add-on si configura tutto dalla UI.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Personal Claude Code login (alternative to the API key):
# HUBNEX_CLAUDE_AUTH_MODE=subscription  # api_key | subscription | hybrid
# HUBNEX_CLAUDE_SUBSCRIPTION_ENABLED=true
# HUBNEX_CLAUDE_API_FALLBACK=false     # hybrid only; API billing must be explicitly enabled
HUBNEX_MODEL=claude-sonnet-5-5
HUBNEX_MODEL_MAIL=claude-haiku-5-5

# --- Altri fornitori (facoltativi): modelli scritti come openai:…, ollama:…, compat:… ---
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://192.168.1.20:11434
# COMPAT_BASE_URL=https://openrouter.ai/api/v1
# COMPAT_API_KEY=
# HUBNEX_OTHER_PRICE_INPUT=0     # $ per milione di token, per openai/compat
# HUBNEX_OTHER_PRICE_OUTPUT=0

# --- Dashboard / API ---
HQ_TOKEN=cambiami-con-una-stringa-lunga
HQ_PORT=8765

# --- Home Assistant ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=long-lived-access-token
HA_BLOCKED_SERVICES=lock.unlock,lock.open,alarm_control_panel.alarm_disarm

# --- Telegram (gruppo con un bot per Jarvis e uno per Jarvis Mail) ---
TELEGRAM_TOKEN_JARVIS=
TELEGRAM_TOKEN_MAIL=
TELEGRAM_ALLOWED_CHAT_ID=-100...
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_VOICE_REPLIES=true

# --- Posta di lavoro ---
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.example.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_FROM_NAME=
MAIL_SIGNATURE=
MAIL_CHECK_INTERVAL_MINUTES=5
MAIL_NOTIFY_MIN_PRIORITY=media

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

TZ=Europe/Rome
HUBNEX_DB=data/hubnex.db
HUBNEX_AGENTS_FILE=config/agents.yaml
